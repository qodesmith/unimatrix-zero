{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": false,
  "embeddedLanguageFormatting": "auto",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "ignorePatterns": [
    ".agents",
    ".claude",
    "**/dist",
    "**/.tsout",
    "skills-lock.json",
    "app/provider-host/src/modules/codex-driver/protocol",
    "bun.lock",
  ],
  "insertFinalNewline": true,
  "jsdoc": {
    "lineWrappingStyle": "balance",
    "preferCodeFences": true,
  },
  "jsxSingleQuote": false,
  "objectWrap": "preserve",
  "overrides": [],
  "printWidth": 80,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": false,
  "singleQuote": true,

  // Sorts declarations; the sort-imports lint rule sorts names inside braces.
  "sortImports": {
    "newlinesBetween": true,
    "order": "asc",
    "sortSideEffects": false,
    "internalPattern": ["^#"],
    "customGroups": [],
    "groups": [
      "type",
      "side_effect_style",
      "side_effect",
      "internal",
      ["external", "builtin"],
      ["parent", "sibling", "index"],
      "unknown",
    ],
  },
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "twMerge"],
    "stylesheet": "app/renderer/src/styles.css",
  },
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
}
