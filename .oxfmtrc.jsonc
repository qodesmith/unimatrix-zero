{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": false,
  "embeddedLanguageFormatting": "auto",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "ignorePatterns": [
    ".agents",
    ".claude",
    "**/dist",
    "**/.tsout",
    "skills-lock.json",
    "bun.lock",
  ],
  "insertFinalNewline": true,
  "jsdoc": {
    "lineWrappingStyle": "balance",
    "preferCodeFences": true,
  },
  "jsxSingleQuote": false,
  "objectWrap": "preserve",
  "overrides": [],
  "printWidth": 80,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": false,
  "singleQuote": true,

  // This combines with the sort-imports lint rule to get full sorting.
  "sortImports": {
    "newlinesBetween": true,
    "order": "asc",
    "sortSideEffects": false,
    "internalPattern": ["^#"],
    "customGroups": [],
    "groups": [
      // All type imports are always at the top.
      "type",

      // Example - `import './styles.css'`
      "side_effect_style",

      // Example - `import 'pkg'`
      "side_effect",

      // Subpath imports. Example - `import {bridge} from '#modules/bridge/main'`
      "internal",

      // Packages found in node_modules and node:* packages.
      ["external", "builtin"],

      // Relative imports.
      ["parent", "sibling", "index"],

      // Everything else.
      "unknown",
    ],
  },
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "twMerge"],
    "stylesheet": "app/renderer/src/styles.css",
  },
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
}
