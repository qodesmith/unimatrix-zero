{
  "name": "unimatrix-zero",
  "private": true,
  "type": "module",
  "reviewed-oxlint-version": "1.89.0",
  "workspaces": [
    "shell",
    "app/*",
    "shared/*",
    "tooling"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --filter '@uz/*' build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "bun run scripts/check-bun-version.ts && bun run scripts/check-oxlint-version.ts && bun run scripts/check-electron-runtime.ts && bun run scripts/check-vendor-binary-overrides.ts && oxlint && bun run scripts/check-css-tokens.ts && bun run scripts/check-us-english.ts",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "knip": "knip",
    "test": "bun run scripts/vitest.ts run",
    "test:node": "bun run scripts/vitest.ts run --project node",
    "test:renderer": "bun run scripts/vitest.ts run --project renderer",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "electron-runtime": "bun run scripts/electron-runtime.ts",
    "codex-protocol": "bun run scripts/codex-protocol.ts",
    "record-fake-reply": "bun run scripts/record-fake-reply.ts",
    "skills:install": "bun run scripts/install-skills.ts",
    "skills:update": "bunx skills update --project -y"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.9.0",
    "@uz/contract": "workspace:*",
    "@uz/provider-host": "workspace:*",
    "@vitest/browser-playwright": "^5.0.5",
    "electron": "^45.0.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:./tooling/no-vendor-binary",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:./tooling/no-vendor-binary"
  }
}
