{
  "name": "unimatrix-zero",
  "private": true,
  "type": "module",
  "workspaces": [
    "shell",
    "app/*",
    "shared/*",
    "tooling"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --filter '@uz/*' build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --max-warnings=0 && bun run scripts/check-css-tokens.ts && bun run scripts/check-us-english.ts",
    "typecheck": "tsc -b",
    "knip": "knip",
    "test": "bun run scripts/vitest.ts run",
    "test:node": "bun run scripts/vitest.ts run --project node",
    "test:renderer": "bun run scripts/vitest.ts run --project renderer",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "electron-runtime": "bun run scripts/electron-runtime.ts",
    "skills:install": "bun run scripts/install-skills.ts",
    "skills:update": "bunx skills update --project -y"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.9.0",
    "@vitest/browser-playwright": "^5.0.5",
    "electron": "^44.9.0",
    "knip": "^6.42.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "rolldown": "^1.2.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
